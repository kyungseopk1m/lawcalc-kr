{
  "schemaVersion": "1",
  "id": "case-006",
  "title": "명시 segments × customRate (구간별 다른 이율)",
  "source": "manual-derivation",
  "notes": "당사자 합의 이율을 두 구간으로 분할 적용. 1차 5%, 2차 10%. totalDays/fixed365/no-first. 초일 불산입은 기산일 2024-01-01 에만 적용하므로 두 번째 구간은 2024-07-01 부터 산입한다. 구간 일수 합 181+184=365 = countDays(2024-01-01, 2024-12-31, 초일불산입). 손계산: 5,000,000 × (0.05×181 + 0.1×184) / 365 = 137,250,000 / 365 = 376,027.397… → floor 376,027.",
  "input": {
    "principal": 5000000,
    "startDate": "2024-01-01",
    "endDate": "2024-12-31",
    "segments": [
      { "from": "2024-01-01", "to": "2024-06-30", "rate": 0.05 },
      { "from": "2024-07-01", "to": "2024-12-31", "rate": 0.1 }
    ],
    "options": {
      "mode": "totalDays",
      "leapYear": "fixed365",
      "includeFirstDay": false
    }
  },
  "expected": {
    "totalInterest": 376027,
    "grandTotal": 5376027,
    "dataVersion": "legal-rates/v1.0.1",
    "segments": [
      {
        "from": "2024-01-01",
        "to": "2024-06-30",
        "days": 181,
        "rate": 0.05,
        "interest": 123972
      },
      {
        "from": "2024-07-01",
        "to": "2024-12-31",
        "days": 184,
        "rate": 0.1,
        "interest": 252054
      }
    ]
  }
}
