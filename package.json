{
  "name": "lawcalc-kr",
  "version": "0.0.0",
  "private": true,
  "description": "한국 법률 계산 데스크톱 워크벤치 (Tauri + React + Rust). 이자·상속분·소송비용·변제충당·손해배상을 공개 법령과 공식 매뉴얼 근거로 계산합니다.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:golden": "pnpm -r --if-present test:golden",
    "sync:datasets": "pnpm -r --if-present sync:datasets",
    "tauri:dev": "pnpm --filter @lawcalc-kr/desktop tauri dev",
    "tauri:build": "pnpm --filter @lawcalc-kr/desktop tauri build",
    "build:icons": "node scripts/build-icons.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "check:hardcoded-version": "node scripts/check-hardcoded-version.mjs"
  },
  "keywords": [
    "korean-law",
    "legal-calculator",
    "interest-calculator",
    "judgment-interest",
    "inheritance-share",
    "litigation-cost",
    "damages-calculator",
    "tauri",
    "lawcalc"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "kyungseopk1m",
  "homepage": "https://github.com/kyungseopk1m/lawcalc-kr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyungseopk1m/lawcalc-kr.git"
  },
  "bugs": {
    "url": "https://github.com/kyungseopk1m/lawcalc-kr/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "^4.1.12",
      "@vitest/mocker": "^4.1.12",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
